# ─── Database ────────────────────────────────────────────────────────────────
# Local dev: SQLite (zero setup)
DATABASE_URL="file:./prisma/dev.db"

# Production (Vercel + Neon / Supabase / any Postgres):
# 1. Change schema.prisma datasource provider to "postgresql"
# 2. Set this to your Postgres connection string
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Random 32+ character secret — run: openssl rand -base64 32
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"

# ─── QR Pass signing ─────────────────────────────────────────────────────────
# Separate secret for QR tourist-pass tokens
QR_SIGNING_SECRET="change-me-generate-with-openssl-rand-base64-32"

# ─── SMS (optional) ──────────────────────────────────────────────────────────
# Semaphore or any SMS gateway credentials (leave blank to disable SMS)
# SMS_API_KEY=""
# SMS_SENDER_NAME=""
