# ─── Database (Neon PostgreSQL — free tier) ──────────────────────────────────
# Get both URLs from Neon dashboard → your project → Connection Details
# Toggle "Connection pooling" ON for DATABASE_URL, OFF for DIRECT_URL

# Pooled connection (used by the app at runtime — required for Vercel serverless)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Direct connection (used by Prisma migrations/db push only)
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Random 32+ character secret — run: openssl rand -base64 32
AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"

# ─── QR Pass signing ─────────────────────────────────────────────────────────
QR_SIGNING_SECRET="change-me-generate-with-openssl-rand-base64-32"

# ─── Cloudinary (image & video storage) ──────────────────────────────────────
# Get from Cloudinary dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ─── SMS (optional) ──────────────────────────────────────────────────────────
# Semaphore (https://semaphore.co) — leave unset and SMS rows stay queued in the
# admin SMS log instead of being sent.
# SEMAPHORE_API_KEY=""
# SEMAPHORE_SENDER=""

# ─── Seeding (npm run seed / npm run db:reset) ────────────────────────────────
# Passwords for the two accounts the seed creates. If unset, the seed generates
# random ones and prints them once. Minimum 12 characters. Never commit real
# values — set them inline for a single run instead:
#   SEED_ADMIN_PASSWORD='...' npm run seed
# SEED_ADMIN_PASSWORD=""
# SEED_CASHIER_PASSWORD=""
