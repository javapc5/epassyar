{
  "name": "epassyar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "deploy": "git pull && npm install && npm run build && pm2 restart epassyar"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "_comment_overrides": "Forces patched transitive copies: next bundles its own postcss, and next's sharp pin predates the libvips CVE fixes. '$postcss' reuses the devDependency version so the two cannot drift apart.",
  "overrides": {
    "sharp": "^0.35.3",
    "postcss": "$postcss"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "6.2.1",
    "cloudinary": "^2.10.0",
    "next": "^16.2.12",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-easy-crop": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/qrcode": "^1.5.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.23",
    "prisma": "6.2.1",
    "tailwindcss": "3.4.17",
    "tsx": "^4.20.6",
    "typescript": "5.7.3"
  }
}
